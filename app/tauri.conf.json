{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DriveCraft",
  "version": "0.1.0",
  "identifier": "io.thinecraft.drivecraft",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DriveCraft",
        "width": 1100,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "publisher": "ThineCraft",
    "copyright": "Copyright (c) DriveCraft contributors. MIT License.",
    "shortDescription": "Synchronize SharePoint and OneDrive for work",
    "longDescription": "DriveCraft synchronizes SharePoint document libraries and OneDrive for work with folders on this computer.",
    "resources": {
      "../target/release/drivecraft.exe": "drivecraft.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
